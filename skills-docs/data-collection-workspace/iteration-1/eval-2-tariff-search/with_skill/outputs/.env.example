# ============================================================
# Credenciais para coleta de dados de tarifas OCDE (2000-2010)
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o arquivo .env no Git.

# CEPII MAcMap (obter em: http://www.cepii.fr/ -> Create account -> Request database access)
# Necessario apenas para download_cepii.py
CEPII_USERNAME=seu_usuario_aqui
CEPII_PASSWORD=sua_senha_aqui

# Harvard Dataverse API Token (opcional, aumenta rate limit)
# Obter em: https://dataverse.harvard.edu/ -> Log in -> API Token
DATAVERSE_API_TOKEN=seu_token_aqui

# WTO Data Portal (opcional, para bulk downloads maiores)
# Obter em: https://data.wto.org/ -> Register
WTO_API_KEY=sua_chave_aqui

# WITS/World Bank (nao requer credencial para API publica)
# OECD Data Explorer (nao requer credencial)
